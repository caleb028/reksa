# =====================================================================
# REKSA — Real Estate Kenya Search & Analysis
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy to .env for local development or deploy to your production host
# =====================================================================

# ---------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ---------------------------------------------------------------------
# For Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# For Production Deployment (PostgreSQL / AWS RDS / Supabase):
# DATABASE_URL="postgresql://reksa_user:secure_password@db.example.com:5432/reksa_prod?connection_limit=20&pool_timeout=10"
# DIRECT_URL="postgresql://reksa_user:secure_password@db.example.com:5432/reksa_prod"

# ---------------------------------------------------------------------
# 2. PLATFORM METADATA & HOSTING
# ---------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="REKSA"
NEXT_PUBLIC_APP_TAGLINE="Kenya's Intelligent Real Estate Marketplace"
NEXT_PUBLIC_APP_URL="http://localhost:3005"
NODE_ENV="development" # Set to "production" in production

# ---------------------------------------------------------------------
# 3. SECURITY, SESSIONS & AUTHENTICATION
# ---------------------------------------------------------------------
# Generate a high-entropy 64-character secret using: openssl rand -hex 32
SESSION_SECRET="generate_a_random_32_or_64_character_hex_secret_here"

# ---------------------------------------------------------------------
# 4. SAFARICOM DARAJA M-PESA GATEWAY
# ---------------------------------------------------------------------
# Environment: "sandbox" (for Daraja sandbox testing) or "production" (live Lipa Na M-Pesa)
MPESA_ENVIRONMENT="sandbox"

# Safaricom Developer Portal Credentials:
# In Sandbox: Obtain from Daraja portal "Sandbox Test Credentials"
# In Production: Obtain after Go-Live approval for your Paybill / Till Number
MPESA_CONSUMER_KEY="your_safaricom_consumer_key"
MPESA_CONSUMER_SECRET="your_safaricom_consumer_secret"
MPESA_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"
MPESA_SHORTCODE="174379"

# Public HTTPS Callback URL for Daraja Webhooks:
# In Production: Must be a publicly reachable HTTPS domain with valid SSL
MPESA_CALLBACK_URL="https://reksa.co.ke/api/payments/mpesa/callback"

# STK Push session timeout (seconds, default: 60)
MPESA_TIMEOUT_SECONDS="60"

# ---------------------------------------------------------------------
# 5. AI INTELLIGENCE & ADVISORY (OPTIONAL)
# ---------------------------------------------------------------------
# Optional: REKSA incorporates deterministic Kenyan property heuristic intelligence
# If an OpenAI key is provided, generative natural-language summaries will be enriched.
OPENAI_API_KEY=""

# ---------------------------------------------------------------------
# 6. EXTERNAL INTEGRATIONS & NOTIFICATIONS (OPTIONAL)
# ---------------------------------------------------------------------
# WhatsApp Business API or SMS Gateway for instant listing alerts:
# SMS_GATEWAY_API_KEY=""
# SMS_GATEWAY_PARTNER_ID=""
# SMS_GATEWAY_SENDER_ID="REKSA"